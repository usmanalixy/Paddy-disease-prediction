<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Paddy" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:colorAccent">@color/pine</item>
        <item name="android:windowBackground">@color/paper</item>
        <item name="android:statusBarColor">@color/paper</item>
        <item name="android:navigationBarColor">@color/paper</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>

    <style name="Widget.Paddy.Button" parent="android:style/Widget.Material.Button">
        <item name="android:minHeight">52dp</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">8dp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="Widget.Paddy.Button.Primary" parent="Widget.Paddy.Button">
        <item name="android:background">@drawable/button_primary</item>
        <item name="android:textColor">@color/card</item>
    </style>

    <style name="Widget.Paddy.Button.Secondary" parent="Widget.Paddy.Button">
        <item name="android:background">@drawable/button_secondary</item>
        <item name="android:textColor">@color/pine</item>
    </style>

    <style name="Widget.Paddy.SectionTitle" parent="">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textSize">19sp</item>
        <item name="android:accessibilityHeading">true</item>
    </style>
</resources>
